{
  "name": "agenthub-desktop",
  "productName": "AgentHub",
  "version": "1.0.0",
  "author": "AgentHub",
  "description": "本地 LLM Agent 代理（桌面版）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.agenthub.desktop",
    "productName": "AgentHub",
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../backend/agenthub.exe", "to": "backend/agenthub.exe" }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}